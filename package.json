{
  "name": "conjureos-living-table",
  "version": "0.4.0",
  "private": true,
  "description": "The Living Table: an AI dungeon master runs your D&D campaign in pixel art, and the dice are real, rolled by the rules engine and never the model.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Jonny-B",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jonny-B/conjureos-living-table.git"
  },
  "//": "No Vite. `npm run dev` is the esbuild dev server from @conjureos/pack; the published build goes through ConjureOS @bundle in CI. Bump `version` here AND in src/version.ts together.",
  "scripts": {
    "dev": "npx -y tsx scripts/assets/build-dev-manifest.ts && conj-pack dev",
    "build": "npx -y tsx scripts/build-bundle.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "npx -y tsx --test test/*.test.ts",
    "bench": "node scripts/kaykit/pack-library.mjs && node scripts/kaykit/pack-cast.mjs && node scripts/asset-bench/build-bench.mjs --assets scripts/asset-bench/assets.ts --out .cache/asset-bench/living-table-bench.html --artifact --data kaylib=.cache/kaykit/bench-library.json --data kaycast=.cache/kaykit/bench-cast.json",
    "kaykit:palette": "npx -y tsx scripts/kaykit/export-palette.ts",
    "kaykit:targets": "npx -y tsx scripts/kaykit/export-targets.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@conjureos/pack": "^0.2.0",
    "@conjureos/ui": "^0.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3"
  },
  "conjureos": {
    "displayName": "The Living Table",
    "icon": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2064%2064%22%20width%3D%2264%22%20height%3D%2264%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%22.5%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%232B1D14%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23120B07%22%2F%3E%3C%2FlinearGradient%3E%3ClinearGradient%20id%3D%22d%22%20x1%3D%22.2%22%20y1%3D%220%22%20x2%3D%22.8%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%23FFE3A3%22%2F%3E%3Cstop%20offset%3D%22.5%22%20stop-color%3D%22%23E9A93B%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%239A5A12%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20fill%3D%22url(%23g)%22%2F%3E%3Cellipse%20cx%3D%2232%22%20cy%3D%2254%22%20rx%3D%2216%22%20ry%3D%223%22%20fill%3D%22%23000%22%20opacity%3D%22.45%22%2F%3E%3Cpolygon%20points%3D%2232%2C9%2052%2C20.5%2052%2C43.5%2032%2C55%2012%2C43.5%2012%2C20.5%22%20fill%3D%22url(%23d)%22%20stroke%3D%22%235A3208%22%20stroke-width%3D%222%22%20stroke-linejoin%3D%22round%22%2F%3E%3Cpolygon%20points%3D%2232%2C20%2043%2C39%2021%2C39%22%20fill%3D%22%23FFF1CC%22%20opacity%3D%22.55%22%20stroke%3D%22%235A3208%22%20stroke-width%3D%221.6%22%20stroke-linejoin%3D%22round%22%2F%3E%3Cpath%20d%3D%22M32%209%2032%2020%20M12%2020.5%2021%2039%20M52%2020.5%2043%2039%20M21%2039%2012%2043.5%20M43%2039%2052%2043.5%20M21%2039%2032%2055%2043%2039%20M12%2020.5%2032%2020%2052%2020.5%22%20fill%3D%22none%22%20stroke%3D%22%235A3208%22%20stroke-width%3D%221.6%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E",
    "permissions": [
      "ai.complete"
    ],
    "actions": {
      "conjureGamesEntry": {
        "permission": "actions.read",
        "description": "Registers The Living Table with Conjure Games: an AI dungeon master runs your D&D campaign, and the dice are real.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "returns": {
          "type": "object",
          "properties": {
            "protocol": {
              "type": "number",
              "description": "Conjure Games registration protocol version. 1 for now."
            },
            "title": {
              "type": "string",
              "description": "The game name to show on the hub."
            },
            "hook": {
              "type": "string",
              "description": "One line under the name."
            }
          },
          "required": [
            "protocol",
            "title",
            "hook"
          ]
        }
      }
    },
    "remoteActions": {
      "gamesDb": {
        "url": "https://ntgelbtepecqsqloxmct.supabase.co/functions/v1/games-db",
        "method": "POST"
      }
    },
    "promptSuggestions": [
      "Start a D&D campaign",
      "Continue my campaign"
    ]
  }
}
